import fetch from "node-fetch";

const API_URL = "https://v2.api-varhad.my.id/search/ytplay";
const MAX_RETRY = 3;

const userRequests = {};

async function fetchSongData(query) {
    let lastError = null;

    for (let attempt = 1; attempt <= MAX_RETRY; attempt++) {
        try {
            const controller = new AbortController();

            const timeout = setTimeout(() => {
                controller.abort();
            }, 30000);

            const res = await fetch(
                `${API_URL}?q=${encodeURIComponent(query)}`,
                {
                    method: "GET",
                    headers: {
                        "User-Agent": "Mozilla/5.0",
                        "Accept": "application/json"
                    },
                    signal: controller.signal
                }
            );

            clearTimeout(timeout);

            if (!res.ok) {
                throw new Error(`HTTP ${res.status}`);
            }

            const raw = await res.text();

            if (!raw) {
                throw new Error("La API devolvió una respuesta vacía");
            }

            let json;

            try {
                json = JSON.parse(raw);
            } catch {
                throw new Error("La API no devolvió JSON válido");
            }

            if (
                json?.status &&
                json?.result
            ) {
                return json;
            }

            throw new Error("Los datos de la canción no son válidos");

        } catch (e) {
            lastError = e;

            console.error(
                `[PL] Intento ${attempt}/${MAX_RETRY} falló:`,
                e.message
            );

            if (attempt < MAX_RETRY) {
                await new Promise(resolve =>
                    setTimeout(resolve, 1500 * attempt)
                );
            }
        }
    }

    throw lastError || new Error(
        "No se pudo obtener la información de la canción"
    );
}


async function fetchBuffer(url) {
    const res = await fetch(url, {
        headers: {
            "User-Agent": "Mozilla/5.0"
        }
    });

    if (!res.ok) {
        throw new Error(
            `Error descargando archivo: HTTP ${res.status}`
        );
    }

    return Buffer.from(
        await res.arrayBuffer()
    );
}


function sanitizeFileName(name = "audio") {
    return String(name)
        .replace(/[\\/:*?"<>|]/g, "")
        .replace(/\s+/g, " ")
        .trim()
        .slice(0, 100) || "audio";
}


export default {

    name: ["pl"],

    help: ["pl"],

    desc: "Busca y descarga música de YouTube",

    tags: ["downloader"],

    limitPrem: true,

    run: async ({
        conn,
        m,
        text,
        prefijo,
        cmd
    }) => {

        const query = text?.trim();

        if (!query) {
            return m.reply(
                `🤔 ¿Qué canción estás buscando?\n\n` +
                `*Usa:*\n` +
                `${prefijo + cmd} <canción o link>\n\n` +
                `*Ejemplo:*\n` +
                `${prefijo + cmd} no se va`
            );
        }


        /*
         * Evita que el mismo usuario
         * haga varias descargas simultáneas.
         */
        if (userRequests[m.sender]) {
            return m.reply(
                `⏳ Hey @${m.sender.split("@")[0]}, ` +
                `espera. Ya tienes una descarga en proceso...`
            );
        }


        userRequests[m.sender] = true;


        try {

            if (typeof m.react === "function") {
                await m.react("⏳");
            }


            /*
             * BUSCAR CANCIÓN
             */
            let json;

            try {

                json = await fetchSongData(query);

            } catch (e) {

                console.error(
                    "[PL API ERROR]",
                    e
                );

                return m.reply(
                    `❌ *No pude obtener la canción.*\n\n` +
                    `> Error: ${e.message}\n\n` +
                    `🔄 Intenta nuevamente en unos segundos.`
                );
            }


            /*
             * DATOS DEVUELTOS POR LA API
             */
            const result = json?.result || {};

            const title =
                result.title ||
                "Audio";

            const youtubeUrl =
                result.url ||
                "";

            const duration =
                result.duration ||
                "Desconocida";

            const thumbnail =
                result.thumbnail ||
                "";

            const mp3 =
                result.mp3 ||
                "";


            if (!mp3) {

                return m.reply(
                    `❌ La API encontró la canción, ` +
                    `pero no proporcionó un enlace de audio.`
                );
            }


            /*
             * MENSAJE DE INFORMACIÓN
             */
            let infoMessage =
                `🎵 *${title}*\n\n` +
                `⏱️ *Duración:* ${duration}\n`;

            if (youtubeUrl) {
                infoMessage +=
                    `🔗 *YouTube:* ${youtubeUrl}\n`;
            }

            infoMessage +=
                `\n> ⏳ Aguarda un momento, ` +
                `estoy enviando tu audio...`;


            /*
             * ENVIAR MINIATURA
             */
            if (thumbnail) {

                try {

                    const thumbBuffer =
                        await fetchBuffer(thumbnail);

                    await conn.sendMessage(
                        m.chat,
                        {
                            image: thumbBuffer,
                            mimetype: "image/jpeg",
                            caption: infoMessage
                        },
                        {
                            quoted: m
                        }
                    );

                } catch (thumbError) {

                    /*
                     * Si falla la miniatura,
                     * NO detenemos la descarga.
                     */
                    console.error(
                        "[PL THUMBNAIL ERROR]",
                        thumbError
                    );

                    await m.reply(infoMessage);
                }

            } else {

                await m.reply(infoMessage);
            }


            /*
             * DESCARGAR MP3
             */
            let audioBuffer;

            try {

                audioBuffer =
                    await fetchBuffer(mp3);

            } catch (e) {

                console.error(
                    "[PL AUDIO DOWNLOAD ERROR]",
                    e
                );

                return m.reply(
                    `❌ *No pude descargar el audio.*\n\n` +
                    `> ${e.message}`
                );
            }


            /*
             * ENVIAR AUDIO
             */
            const fileName =
                `${sanitizeFileName(title)}.mp3`;


            await conn.sendMessage(
                m.chat,
                {
                    audio: audioBuffer,
                    mimetype: "audio/mpeg",
                    fileName,
                    ptt: false,
                    contextInfo: {}
                },
                {
                    quoted: m
                }
            );


            if (typeof m.react === "function") {
                await m.react("✅");
            }


        } catch (e) {

            console.error(
                "❌ Error en comando PL:",
                e
            );

            if (typeof m.react === "function") {
                await m.react("❌");
            }

            return m.reply(
                `❌ Ocurrió un error al procesar la canción.\n\n` +
                `> ${e.message}`
            );

        } finally {

            delete userRequests[m.sender];

        }
    }
};
